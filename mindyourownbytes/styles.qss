QWidget#shell, QWidget#body {
    background: #0c1321;
    color: #e9eef9;
}
QWidget {
    font-family: "Segoe UI";
    font-size: 12px;
    color: #e9eef9;
}
QScrollArea#pageScroll, QScrollArea#pageScroll > QWidget {
    background: #0c1321;
    border: 0;
}
QFrame#sidebar {
    background: #111d30;
    border-right: 1px solid #203047;
}
QDialog, QMessageBox, QInputDialog {
    background: #142237;
}
QDialog QLabel, QMessageBox QLabel {
    background: transparent;
    color: #e9eef9;
}
QLabel#hintLabel {
    color: #ffd479;
}
QCheckBox {
    color: #c6d4e6;
    spacing: 8px;
}
QLabel#brand {
    font-size: 21px;
    font-weight: 800;
    color: #76d6c3;
    letter-spacing: 1px;
}
QLabel#brandSub {
    color: #a5b7cf;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 2px;
}
QLabel#title {
    font-size: 26px;
    font-weight: 700;
    color: #f7faff;
}
QLabel#mutedLabel {
    color: #9aaec6;
    font-size: 12px;
}
QLabel#eyebrow {
    color: #8ea7be;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 1.5px;
}
QLabel#badge {
    border: 1px solid #1e6d66;
    border-radius: 12px;
    padding: 7px 13px;
    background: #10352f;
    color: #8ae5cf;
    font-size: 10px;
    font-weight: 750;
}
QLabel#sidebarInfo {
    color: #96b8b5;
    border: 1px solid #2a4550;
    background: #152a36;
    border-radius: 10px;
    padding: 13px;
    line-height: 130%;
}
QLabel#sidebarFoot {
    color: #708ba5;
    font-size: 10px;
    line-height: 140%;
}
QFrame#dropZone {
    border: 2px dashed #35516d;
    border-radius: 16px;
    background: #142337;
}
QFrame#dropZone:hover {
    border: 2px dashed #56bba9;
    background: #183047;
}
QLabel#dropIcon {
    color: #70d5c0;
    font-size: 33px;
    font-weight: bold;
}
QLabel#dropTitle {
    color: #f1f7ff;
    font-size: 16px;
    font-weight: 700;
}
QFrame#optionsCard {
    border: 1px solid #2b3d55;
    background: #142237;
    border-radius: 13px;
}
QPushButton {
    border-radius: 9px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 650;
    background: #26384e;
    border: 1px solid #38506a;
    color: #e8eff9;
}
QPushButton:hover { background: #31475f; border-color: #587595; }
QPushButton:pressed { background: #1b2d41; }
QPushButton:disabled { color: #5e738a; background: #1d2a3b; border-color: #2a3544; }
QPushButton[variant="primary"] {
    background: #5ad6bc;
    color: #07251f;
    border: 1px solid #5ad6bc;
    padding-left: 20px;
    padding-right: 20px;
    font-weight: 800;
}
QPushButton[variant="primary"]:hover { background: #83ead4; }
QPushButton[variant="primary"]:disabled { background: #2b514d; color: #6a9087; border-color: #2b514d; }
QPushButton[variant="subtle"] {
    background: transparent;
    border: 1px solid #283b50;
    color: #a9bdd4;
}
QPushButton[variant="subtle"]:hover { background: #1a3046; }
QPushButton[variant="nav"], QPushButton[variant="navActive"] {
    text-align: left;
    border: 0;
    border-radius: 10px;
    min-height: 42px;
    padding-left: 13px;
    font-size: 13px;
}
QPushButton[variant="nav"] { background: transparent; color: #aebfd5; }
QPushButton[variant="nav"]:hover { background: #20334a; }
QPushButton[variant="navActive"] {
    background: #174e4b;
    color: #b1ffeb;
    font-weight: 750;
}
QPushButton[variant="danger"] {
    color: #ffc4bd;
    background: #553139;
    border-color: #71414a;
}
QPushButton[variant="danger"]:hover { background: #6c3c45; }
QLineEdit, QComboBox {
    border-radius: 7px;
    background: #0d1b2c;
    border: 1px solid #36516c;
    padding: 8px 10px;
    color: #e5f2ff;
    min-height: 20px;
    selection-background-color: #246b64;
}
QComboBox:drop-down { border: 0; width: 24px; }
QComboBox QAbstractItemView {
    background: #14273b;
    color: #e9eef9;
    border: 1px solid #36516c;
    selection-background-color: #235c58;
}
QTableWidget {
    background: #101d2f;
    alternate-background-color: #142135;
    color: #e3ecf8;
    border: 1px solid #293b52;
    border-radius: 11px;
    gridline-color: transparent;
    selection-background-color: #1c514d;
    selection-color: #ecfff9;
    outline: none;
}
QTableWidget::item { padding: 5px 8px; border: 0; }
QHeaderView::section {
    background: #1d3048;
    color: #91a9bf;
    border: 0;
    border-bottom: 1px solid #32485f;
    padding: 9px;
    font-size: 10px;
    font-weight: 750;
}
QScrollBar:vertical {
    background: #0e1b2c;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical { background: #3e536b; border-radius: 4px; min-height: 18px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QProgressBar {
    border: 0;
    border-radius: 4px;
    background: #253d4e;
    height: 9px;
}
QProgressBar::chunk { background: #5ad6bc; border-radius: 4px; }
QToolTip { color: #f0f7ff; background-color: #142439; border: 1px solid #456076; }
