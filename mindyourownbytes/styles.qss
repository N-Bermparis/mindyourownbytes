/*
 * Only what a native style has no concept of. Everything not listed here, including
 * all dialogs, is drawn by the platform's own style, so it looks right and stays
 * readable in both light and dark mode. Color names between at-signs come from gui/theme.py.
 */

QScrollArea#pageScroll, QScrollArea#pageScroll > QWidget > QWidget { background: transparent; border: 0; }

/* Sidebar */
QLabel#brand { font-size: 11pt; font-weight: 600; }
QLabel#sidebarNote { color: @muted@; font-size: 9pt; }
QPushButton#navItem {
    text-align: left;
    padding: 7px 10px;
    border: 0;
    border-left: 3px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: @text@;
}
QPushButton#navItem:hover { background: @nav_hover@; }
QPushButton#navItem:checked {
    background: @nav_active@;
    border-left: 3px solid @accent@;
    font-weight: 600;
}
QPushButton#navItem:disabled { color: @disabled_fg@; }

/* Text */
QLabel#title { font-size: 18pt; font-weight: 600; }
QLabel#muted { color: @muted@; }
QLabel#stepTitle { font-size: 11pt; font-weight: 600; }
QLabel#emptyTitle { font-size: 12pt; font-weight: 600; }
QLabel#optionTitle { font-weight: 600; }
QLabel#hintLabel { color: @warn@; }
QLabel#stepNumber {
    background: @accent@;
    color: @on_accent@;
    border-radius: 10px;
    min-width: 20px; max-width: 20px; min-height: 20px; max-height: 20px;
    font-size: 9pt;
    font-weight: 600;
}

/* Surfaces */
QFrame#card {
    background: @card@;
    border: 1px solid @border@;
    border-radius: 8px;
}
QFrame#card QLabel { background: transparent; }
QFrame#dropZone {
    background: @drop@;
    border: 2px dashed @drop_border@;
    border-radius: 8px;
}
QFrame#dropZone[dragging="true"] {
    background: @drop_active@;
    border: 2px dashed @accent@;
}
QFrame#card[dragging="true"] { border: 1px solid @accent@; }

/* Messages inside a page */
QFrame#infoBar { border-radius: 6px; border: 1px solid @border@; }
QFrame#infoBar[kind="success"] { background: @ok_bg@; border-color: @ok_border@; }
QFrame#infoBar[kind="warning"] { background: @warn_bg@; border-color: @warn_border@; }
QFrame#infoBar[kind="error"] { background: @error_bg@; border-color: @error_border@; }
QFrame#infoBar[kind="info"] { background: @info_bg@; border-color: @info_border@; }
QFrame#infoBar QLabel { background: transparent; }
QLabel#infoTitle { font-weight: 600; }

/* The one button on each screen that moves you forward */
QPushButton[variant="primary"] {
    background: @accent@;
    color: @on_accent@;
    border: 1px solid @accent@;
    border-radius: 5px;
    padding: 6px 18px;
    min-height: 20px;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover { background: @accent_hover@; border-color: @accent_hover@; }
QPushButton[variant="primary"]:pressed { background: @accent_pressed@; border-color: @accent_pressed@; }
QPushButton[variant="primary"]:disabled {
    background: @disabled_bg@;
    border-color: @disabled_bg@;
    color: @disabled_fg@;
}
